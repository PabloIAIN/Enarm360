# ==========================================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==========================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=enarm360
DB_USERNAME=enarmdev
DB_PASSWORD=tu_password_aqui

# ==========================================================
# CONFIGURACIÓN JWT
# ==========================================================
JWT_SECRET=tu_jwt_secret_aqui
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ==========================================================
# CONFIGURACIÓN CORS
# ==========================================================
CORS_ALLOWED_ORIGINS=https://enarm360.com,https://www.enarm360.com,http://localhost:3000

# ==========================================================
# CONFIGURACIÓN DE EMAIL (Gmail)
# ==========================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_app_password_aqui

# ==========================================================
# CONFIGURACIÓN DE SMS (Twilio)
# ==========================================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_FROM_NUMBER=+1234567890

# ==========================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ==========================================================
APP_NAME=ENARM360
APP_URL=https://enarm360.com
APP_MAIL_FROM=no-reply@enarm360.com

# ==========================================================
# CONFIGURACIÓN DE SERVIDOR
# ==========================================================
SERVER_PORT=8080

# ==========================================================
# CONFIGURACIÓN DE UPLOADS
# ==========================================================
UPLOADS_DIR=/opt/enarm360/uploads
UPLOADS_PUBLIC_BASE=/files/
